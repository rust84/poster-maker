# TMDB API key — required
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OpenAI API key — required for inpainting (text removal from background)
# Skip inpainting at runtime with: --skip-inpaint
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key — required for intelligent logo-to-white conversion
# Falls back to PIL-based extraction if not set
GEMINI_API_KEY=your_gemini_api_key_here
